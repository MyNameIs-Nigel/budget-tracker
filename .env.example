# Copy to .env.local. Local Postgres only; use Neon credentials in Vercel.
DATABASE_URL=postgresql://budget:budget@localhost:5433/budget
BETTER_AUTH_SECRET=local-dev-only-change-for-production-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Non-secret configuration. Comma-separated; these accounts bootstrap enabled.
ADMIN_EMAILS=nigel.nds.smith@gmail.com

# Google is optional for local development. Set both on Vercel.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Local fake accounts only; ignored on every Vercel environment and remote DBs.
E2E_AUTH=1

# Canonical public origin for SEO, social cards, and sitemap (not a preview URL).
SITE_URL=https://budget.nigel-smith.dev
